void Initialization()
{
	DIO_voidInit();
	LCD_voidIntialization();
	LCD_voidWriteMoveString("LOADING...");

	LM35_voidInit();
  /* the initialization for all components */
	_delay_ms(250);

	LCD_voidClear();
	LCD_voidWriteMoveString("SETUP_DONE");
	_delay_ms(250);
	LCD_voidClear();

	LCD_voidWriteString("TEMP : ",0);
  /* the lcd const display here*/
}
